generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model curso {
  id_curso_pk         Int                   @id @default(autoincrement())
  nome_curso          String                @db.VarChar(100)
  tipo_curso          curso_tipo_curso
  registro_pedagogico registro_pedagogico[]
}

model registro_pedagogico {
  id_registro_pk    Int                                   @id @default(autoincrement())
  id_usuario_fk     Int
  id_curso_fk       Int?
  tipo_relatorio    registro_pedagogico_tipo_relatorio
  status_registro   registro_pedagogico_status_registro
  turno             registro_pedagogico_turno?
  modalidade        registro_pedagogico_modalidade?
  data_inicial      DateTime                              @db.Date
  data_encerramento DateTime?                             @db.Date
  data_conclusao    DateTime                              @default(now()) @db.Timestamp(0)
  turma             String?                               @db.VarChar(30)
  tipo_atendimento  registro_pedagogico_tipo_atendimento?
  tipo_acao         registro_pedagogico_tipo_acao?
  tipo_contratacao  registro_pedagogico_tipo_contratacao?
  relatorio         registro_pedagogico_relatorio?
  pedagogo          String?                               @db.VarChar(120)
  instrutor_aluno   String?                               @db.VarChar(120)
  coordenacao       String?                               @db.VarChar(120)
  docente           String?                               @db.VarChar(120)
  tratativa_nep     String?                               @db.Text
  descricao         String?                               @db.Text
  usuario           usuario                               @relation(fields: [id_usuario_fk], references: [id_usuario_pk], onUpdate: Restrict, map: "registro_pedagogico_ibfk_1")
  curso             curso?                                @relation(fields: [id_curso_fk], references: [id_curso_pk], onDelete: Restrict, onUpdate: Restrict, map: "registro_pedagogico_ibfk_2")

  @@index([id_curso_fk], map: "id_curso_fk")
  @@index([id_usuario_fk], map: "id_usuario_fk")
}

model usuario {
  id_usuario_pk         Int                   @id @default(autoincrement())
  nome_completo         String                @db.VarChar(120)
  email_usu             String                @unique(map: "email_usu") @db.VarChar(150)
  senha_usu             String                @db.VarChar(255)
  preferencia_tema      Boolean?
  preferencia_contraste Boolean?
  token_lembrar_me      String?               @db.VarChar(255)
  registro_pedagogico   registro_pedagogico[]
}

enum curso_tipo_curso {
  tecnico
  curso_de_qualificacao_aperfeicoamento_extensao
  programas
}

enum registro_pedagogico_tipo_relatorio {
  atendimento_geral
  acompanhamento_pedagogico
}

enum registro_pedagogico_status_registro {
  pendente
  andamento
  finalizado
}

enum registro_pedagogico_turno {
  manha
  tarde
  noite
}

enum registro_pedagogico_modalidade {
  presencial
  ead
  hibrido
}

enum registro_pedagogico_tipo_atendimento {
  acolhimento
  acompanhamento
  afastamento_temporario
  advertencia
  ambientacao_docente
  aplicacao_de_pesquisa
  apoio_a_coordenacao
  atendimento_emergencial
  boas_vindas
  calcado_inadequado
  fardamento_inadequado
  intervencao_pedagogica
  miniaula
  na
  orientacao_aluno
  orientacao_reuniao_instrutora
  outros
  pais_resp
  reuniao
  visita_pedagogica
}

enum registro_pedagogico_tipo_acao {
  acompanhamento_docente_turma
  docente
}

enum registro_pedagogico_tipo_contratacao {
  horista
  mensalista
  rsa
}

enum registro_pedagogico_relatorio {
  na
  arquivado
  andamento
  falta_feedback
  observacoes
}
